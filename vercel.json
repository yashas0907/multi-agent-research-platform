# Vercel free-tier deployment for the frontend.
# Deploy: push the repo, then on vercel.com: Add New → Project → import this repo.
# Set VITE_API_URL in Vercel's dashboard (Settings → Environment Variables)
# to your Render backend URL, e.g. https://research-platform-api.onrender.com

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
