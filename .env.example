# =============================================================================
# Multi-Agent Research & Intelligence Platform — Environment Configuration
# Copy this file to `.env` and fill in values. NEVER commit your real `.env`.
# =============================================================================

# --- Application ---
APP_NAME="Multi-Agent Research & Intelligence Platform"
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/research_platform.db

# --- LLM Provider -------------------------------------------------------------
# provider: openai | groq | mock   (mock = deterministic offline provider for
#         development/testing; no API key required)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Alternate provider (used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings ---------------------------------------------------------------
# provider: openai | mock  (mock = hashing-based deterministic embeddings,
#         no network required)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# --- Web Search ---------------------------------------------------------------
# provider: duckduckgo | offline   (offline = curated local corpus, no network)
# Set to offline for reproducible development/testing without internet access.
WEB_SEARCH_PROVIDER=offline
WEB_SEARCH_MAX_RESULTS=8
WEB_FETCH_TIMEOUT_SECONDS=15

# --- Research Budget / Cost Control ------------------------------------------
RESEARCH_MAX_ITERATIONS=3
RESEARCH_MAX_SEARCHES=12
RESEARCH_MAX_SOURCES=15
RESEARCH_MAX_TOKENS=150000
RESEARCH_MAX_RUNTIME_SECONDS=600

# --- Depth profiles (quick|standard|deep) are defined in config/research_profiles.yaml

# --- Uploads & Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20
VECTOR_STORE_DIR=./data/vector_store

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json
# Traces contain only safe operational events — never prompts or chain-of-thought.
